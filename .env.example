# Resend API key for the hire, CV, and contact forms.
# Copy this file to .env.local and set the key there. Never commit the real key.
RESEND_API_KEY=

# Inbox that receives form submissions.
CONTACT_TO_EMAIL=michael.allen@bridgewide.org

# Sender address passed to Resend.
# onboarding@resend.dev is Resend's sandbox sender. It only delivers to the
# email address on the Resend account until a domain is verified. After the
# domain is verified, swap CONTACT_FROM_EMAIL to a verified sender on that
# domain (for example noreply@bridgewide.org).
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Bearer token for /api/cron/* (Authorization: Bearer <token>). Vercel sends it to its cron jobs.
# Required in production. With no token the routes refuse every request.
CRON_SECRET=

# Local development only: set to 1 to let the cron routes run with no CRON_SECRET.
# Ignored when NODE_ENV is production.
# DESK_ALLOW_UNAUTHENTICATED=1


# Cloudflare Turnstile, the spam check on every form. Create a widget in the Cloudflare
# dashboard (Turnstile), then set both keys. The site key is public; the secret key
# is not. With no secret key the check is skipped, so local work needs no account.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry error reports. The project key (DSN) lives in src/lib/sentry-dsn.ts, so no
# variable is needed. These two override it (server and browser); leave them empty
# normally. Request bodies, cookies, headers, query strings, and email addresses are
# removed before anything is sent (see src/lib/sentry-scrub.ts).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
