# Resend API key for the hire, CV, and contact forms.
# Copy this file to .env.local and set the key there. Never commit the real key.
RESEND_API_KEY=

# Inbox that receives form submissions.
CONTACT_TO_EMAIL=hello@bridgewide.com

# Sender address passed to Resend.
# onboarding@resend.dev is Resend's sandbox sender. It only delivers to the
# email address on the Resend account until a domain is verified. After the
# domain is verified, swap CONTACT_FROM_EMAIL to a verified sender on that
# domain (for example hello@bridgewide.com).
CONTACT_FROM_EMAIL=onboarding@resend.dev
